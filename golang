#!/bin/bash

# golang - A script to update Go versions
# Usage: golang update <version>

set -e

GO_INSTALL_DIR="/usr/local/go"
BACKUP_DIR="/usr/local/go.bak"
DOWNLOAD_URL_BASE="https://golang.org/dl"

# Function to print usage
usage() {
    echo "Usage: $0 update <version>"
    echo "Example: $0 update 1.22.1"
    exit 1
}

# Check for correct number of arguments
if [ "$1" != "update" ] || [ -z "$2" ]; then
    usage
fi

VERSION=$2
ARCH=$(uname -m)
OS=$(uname -s | tr '[:upper:]' '[:lower:]')

# Map architecture names
case "$ARCH" in
    x86_64) ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
    armv7l) ARCH="armv6l" ;;
    i386|i686) ARCH="386" ;;
esac

TARBALL="go${VERSION}.${OS}-${ARCH}.tar.gz"
DOWNLOAD_URL="${DOWNLOAD_URL_BASE}/${TARBALL}"

echo "Update requested to Go version: ${VERSION}"
echo "Platform: ${OS}/${ARCH}"

# 1. Determine currently installed version
if [ -d "$GO_INSTALL_DIR" ]; then
    CURRENT_VER=$("$GO_INSTALL_DIR/bin/go" version | awk '{print $3}')
    echo "Currently installed: ${CURRENT_VER}"
else
    echo "Go is not currently installed at ${GO_INSTALL_DIR}"
fi

# 2. Download the new version
echo "Downloading ${DOWNLOAD_URL}..."
curl -L -O "$DOWNLOAD_URL" || { echo "Failed to download Go ${VERSION}. Please check the version number."; exit 1; }

# 3. Backup old version (temporarily)
if [ -d "$GO_INSTALL_DIR" ]; then
    echo "Backing up current installation to ${BACKUP_DIR}..."
    sudo rm -rf "$BACKUP_DIR"
    sudo mv "$GO_INSTALL_DIR" "$BACKUP_DIR"
fi

# 4. Install the new version
echo "Installing Go ${VERSION}..."
sudo mkdir -p /usr/local
sudo tar -C /usr/local -xzf "$TARBALL"

# 5. Validate the install
echo "Validating installation..."
NEW_VER=$("$GO_INSTALL_DIR/bin/go" version | awk '{print $3}')

if [[ "$NEW_VER" == *"$VERSION"* ]]; then
    echo "Successfully installed Go ${VERSION}!"
    # 6. Remove backup and tarball
    echo "Cleaning up..."
    sudo rm -rf "$BACKUP_DIR"
    rm "$TARBALL"
else
    echo "Validation failed! Expected version ${VERSION}, but got ${NEW_VER}."
    echo "Restoring backup..."
    sudo rm -rf "$GO_INSTALL_DIR"
    sudo mv "$BACKUP_DIR" "$GO_INSTALL_DIR"
    exit 1
fi
